---
import ActionList from '@littzite/ui/ActionList.astro';
import Link from '@littzite/ui/Link.astro';

const one = [
  {
    id: 'book',
    label: 'Action A',
    href: 'https://example.test/action-a',
    note: 'An optional note.',
  },
];
const many = [
  { id: 'first', label: 'First action', href: '/first' },
  {
    id: 'second',
    label: 'Second action',
    href: 'https://example.test/second',
    icon: 'external' as const,
  },
];
---

<html lang="en">
  <body>
    <div data-case="zero">
      <ActionList idPrefix="empty" actions={[]} />
    </div>
    <div data-case="one">
      <ActionList idPrefix="single-list" actions={one} />
    </div>
    <div data-case="many">
      <ActionList idPrefix="service-many" actions={many} />
    </div>
    <div data-case="same-action-id-a">
      <ActionList idPrefix="service-a" actions={one} />
    </div>
    <div data-case="same-action-id-b">
      <ActionList idPrefix="service-b" actions={one} />
    </div>
    <Link href="/legacy">Legacy link</Link>
  </body>
</html>
