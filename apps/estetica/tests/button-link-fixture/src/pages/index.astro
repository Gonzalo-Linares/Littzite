---
import ButtonLink from '@littzite/ui/ButtonLink.astro';
import Link from '@littzite/ui/Link.astro';
---

<html lang="es-AR">
  <body>
    <ButtonLink href="/seguro/" variant="primary">
      Principal
    </ButtonLink>
    <ButtonLink href="https://example.test/" variant="secondary">
      Secundario
    </ButtonLink>
    <ButtonLink href="#inicio" variant="quiet" size="compact" describedBy="nota">
      Contextual
    </ButtonLink>
    <ButtonLink href="https://example.test/booking" icon="external">
      Agenda externa
    </ButtonLink>
    <ButtonLink href="https://wa.me/5492641234567" newTab>
      Consultar por WhatsApp
    </ButtonLink>
    <ButtonLink href="/servicios/" icon="back">
      Volver a servicios
    </ButtonLink>
    <ButtonLink href="mailto:legal@example.com?subject=Solicitud%20de%20arrepentimiento">
      Contacto legal
    </ButtonLink>
    <Link href="https://www.instagram.com/vioramasajes.ok/" ariaLabel="VIORA en Instagram">
      Icono social accesible
    </Link>
  </body>
</html>
