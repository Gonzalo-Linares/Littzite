---
import Container from '@littzite/ui/Container.astro';
import { seoMetadataSchema } from '@littzite/content-schema';
import VioraSiteLayout from '../layouts/VioraSiteLayout.astro';

const seo = seoMetadataSchema.parse({
  title: 'Página no encontrada | VIORA · Vista previa',
  description:
    'La página que buscás no existe en esta vista previa de VIORA. Podés volver al inicio o explorar las experiencias.',
});
---

<VioraSiteLayout seo={seo}>
  <section class="viora-not-found" aria-labelledby="viora-not-found-title">
    <Container>
      <p class="viora-not-found__eyebrow">VIORA / 404</p>
      <h1 id="viora-not-found-title">Esta página no existe.</h1>
      <p>El enlace puede haber cambiado o no estar disponible en esta vista previa.</p>
      <div class="viora-not-found__actions">
        <a class="action-link" href="/">
          Volver al inicio
        </a>
        <a class="viora-not-found__catalog-link" href="/#alcance">
          Ver experiencias
        </a>
      </div>
    </Container>
  </section>
</VioraSiteLayout>
