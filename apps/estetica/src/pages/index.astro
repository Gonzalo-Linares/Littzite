---
import LandingHero from '@littzite/sections/LandingHero.astro';
import ButtonLink from '@littzite/ui/ButtonLink.astro';
import VioraServiceRail from '../components/VioraServiceRail.astro';
import VioraSiteLayout from '../layouts/VioraSiteLayout.astro';
import { siteContent } from '../site.config';
import { serviceVisuals } from '../service-visuals';
import heroImage from '../assets/viora-hero.jpg';
import heroImageSmall from '../assets/viora-hero-small.jpg';

const { pages } = siteContent;
const home = pages.find((page) => page.slug === '');
const intro = home?.sections.find((section) => section.type === 'intro');
if (!home || !intro) throw new Error('Incomplete VIORA preview content');
---

<VioraSiteLayout seo={home.seo}>
  <LandingHero
    section={intro}
    variant="serene"
    ctaLabel="Conocé nuestras experiencias"
    ctaHref="/servicios/"
    artLabel="UN RESPIRO PARA VOS"
  >
    <picture slot="artwork" class="viora-hero-photo-frame">
      <img
        class="viora-hero-photo"
        src={heroImage.src}
        srcset={`${heroImageSmall.src} ${heroImageSmall.width}w, ${heroImage.src} ${heroImage.width}w`}
        sizes="(min-width: 1180px) 48vw, (min-width: 741px) 45vw, calc(100vw - 2rem)"
        width={heroImage.width}
        height={heroImage.height}
        alt=""
        decoding="async"
        fetchpriority="high"
      />
    </picture>
  </LandingHero>

  <VioraServiceRail
    id="alcance"
    eyebrow="Nuestro universo"
    title="Cada cuidado tiene su momento."
    description="Conocé las líneas de VIORA y explorá cada experiencia."
    services={siteContent.services}
    visuals={serviceVisuals}
  />

  <section
    class="viora-home-teaser viora-home-teaser--story"
    aria-labelledby="viora-home-story-title"
  >
    <div class="container viora-home-teaser__inner">
      <div>
        <p class="viora-home-teaser__eyebrow">Una forma de cuidar</p>
        <h2 id="viora-home-story-title">Una identidad para cuidar.</h2>
        <p>Una propuesta cercana, atenta y honesta para acompañar tus momentos de bienestar.</p>
      </div>
      <ButtonLink href="/viora/" variant="secondary">
        Conocé VIORA
      </ButtonLink>
    </div>
  </section>

  <section class="viora-contact-teaser" aria-labelledby="viora-contact-teaser-title">
    <div class="container viora-contact-teaser__inner">
      <div>
        <p class="viora-home-teaser__eyebrow">Encontranos</p>
        <h2 id="viora-contact-teaser-title">Un espacio para tu bienestar.</h2>
        <p>Rivadavia, San Juan, Argentina. Encontrá las indicaciones y el Instagram oficial.</p>
      </div>
      <ButtonLink href="/contacto/" variant="secondary">
        Ver contacto
      </ButtonLink>
    </div>
  </section>
</VioraSiteLayout>
