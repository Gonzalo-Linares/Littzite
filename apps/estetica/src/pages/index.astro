---
import BaseLayout from '@littzite/ui/BaseLayout.astro';
import Container from '@littzite/ui/Container.astro';
import Link from '@littzite/ui/Link.astro';
import { siteContent } from '../site.config';

const { site, pages } = siteContent;
const home = pages.find((page) => page.slug === '');
if (!home) throw new Error('Missing home page');
---

<BaseLayout locale={site.defaultLocale} theme={site.theme} title={home.title} noindex={true}>
  <Container>
    {home.sections.map((section) => section.type === 'intro' && <section id="alcance"><h1>{section.heading}</h1><p>{section.body}</p></section>)}
    <Link href="#alcance">Ver alcance del demo</Link>
  </Container>
</BaseLayout>
