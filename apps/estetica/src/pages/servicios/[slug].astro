---
import ButtonLink from '@littzite/ui/ButtonLink.astro';
import VioraSiteLayout from '../../layouts/VioraSiteLayout.astro';
import ServiceVisual from '../../components/ServiceVisual.astro';
import VioraServicePricing from '../../components/VioraServicePricing.astro';
import VioraProfessional from '../../components/VioraProfessional.astro';
import VioraInquiry from '../../components/VioraInquiry.astro';
import { siteContent } from '../../site.config';
import { serviceVisuals } from '../../service-visuals';
import { resolveServiceVisual } from '../../service-visuals.validation';
import { serviceDetailFor } from '../../viora-commercial-content';
export function getStaticPaths() {
  return siteContent.services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}
const { service } = Astro.props;
const visual = resolveServiceVisual(serviceVisuals, service.id);
const detail = serviceDetailFor(service.id);
---

<VioraSiteLayout
  seo={{
    title: service.displayName + ' | VIORA · Estética integral',
    description: service.description,
  }}
>
  <section
    class="viora-service-detail viora-commercial-detail"
    aria-labelledby="viora-service-title"
  >
    <div class="container">
      <article class="viora-service-detail__hero">
        <div class="viora-commercial-detail__intro">
          <ButtonLink href="/servicios/" variant="quiet" size="compact" icon="back">
            Servicios
          </ButtonLink>
          <h1
            id="viora-service-title"
            style={'view-transition-name: viora-service-' + service.slug}
          >
            {service.displayName}
          </h1>
          <p>{detail.intro ?? service.description}</p>
          <ButtonLink href="#opciones" variant="secondary">
            Ver opciones y precios
          </ButtonLink>
        </div>
        {visual && (
          <div class="viora-service-detail__media">
            <ServiceVisual
              visual={visual}
              context="detail-primary"
              transitionName={'viora-service-image-' + service.slug}
            />
          </div>
        )}
      </article>
      <div class="viora-commercial-detail__body">
        <div class="viora-commercial-detail__information">
          {detail.intro && (
            <section>
              <h2>Qué es</h2>
              <p>{detail.intro}</p>
            </section>
          )}
          {detail.purpose && (
            <section>
              <h2>Objetivo</h2>
              <p>{detail.purpose}</p>
            </section>
          )}
          {Boolean(detail.includes?.length) && (
            <section>
              <h2>Qué incluye</h2>
              <ul>
                {detail.includes?.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          )}
          {Boolean(detail.session?.length) && (
            <section>
              <h2>Cómo es la sesión</h2>
              <ol>
                {detail.session?.map((item) => (
                  <li>{item}</li>
                ))}
              </ol>
            </section>
          )}
          {detail.contentStatus === 'pending' && (
            <p class="viora-commercial-detail__pending">
              Estamos preparando los detalles de esta propuesta. Podés consultarnos antes de
              reservar.
            </p>
          )}
          {visual?.reveal && (
            <div class="viora-service-detail__secondary-scene">
              <ServiceVisual visual={visual} context="detail-secondary" />
            </div>
          )}
        </div>
        <VioraServicePricing service={service} pricing={detail.pricing} />
      </div>
    </div>
  </section>
  <VioraProfessional compact />
  {Boolean(detail.faq?.length) && (
    <section
      class="viora-service-faq viora-commercial-section"
      aria-labelledby="viora-service-faq-title"
    >
      <div class="container">
        <h2 id="viora-service-faq-title">Preguntas frecuentes</h2>
        {detail.faq?.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}
  <VioraInquiry showBooking={service.actions.some((action) => action.type === 'direct-booking')} />
</VioraSiteLayout>
