---
import Container from '@littzite/ui/Container.astro';
import VioraSiteLayout from '../../layouts/VioraSiteLayout.astro';
import ServiceVisual from '../../components/ServiceVisual.astro';
import { siteContent } from '../../site.config';
import { serviceVisuals } from '../../service-visuals';
import { resolveServiceVisual } from '../../service-visuals.validation';
import { resolveDirectBookingAction } from '@littzite/booking';
import ActionList from '@littzite/ui/ActionList.astro';

export function getStaticPaths() {
  return siteContent.services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const visual = resolveServiceVisual(serviceVisuals, service.id);
const actions = service.actions
  .filter((action) => action.type === 'direct-booking')
  .map((action) => {
    const resolved = resolveDirectBookingAction(action, siteContent.bookingTargets);
    return {
      id: resolved.actionId,
      label: resolved.label,
      href: resolved.href,
      note: resolved.eligibilityNote,
    };
  });
---

<VioraSiteLayout
  seo={{ title: `${service.displayName} | VIORA · Vista previa`, description: service.description }}
>
  <section class="viora-service-detail" aria-labelledby="viora-service-title">
    <Container>
      <a class="viora-service-detail__back" href="/servicios/">
        ← Volver a servicios
      </a>
      <article class:list={{ 'viora-service-detail__article--visual': visual !== undefined }}>
        <div class="viora-service-detail__copy">
          <p class="viora-service-detail__eyebrow">VIORA / servicios</p>
          <h1
            id="viora-service-title"
            style={`view-transition-name: viora-service-${service.slug}`}
          >
            {service.displayName}
          </h1>
          <p class="viora-service-detail__description">{service.description}</p>
          <p class="viora-service-detail__note">
            Esta información es orientativa. Los detalles del servicio y su disponibilidad se
            confirmarán antes de ofrecer turnos.
          </p>
          {visual && (
            <p class="viora-service-detail__visual-note">
              Fotografía ilustrativa; no representa al equipo, el espacio ni las técnicas de VIORA.
            </p>
          )}
        </div>
        {visual && (
          <ServiceVisual
            visual={visual}
            context="detail-primary"
            transitionName={`viora-service-image-${service.slug}`}
          />
        )}
      </article>
      {visual?.reveal && (
        <div
          class="viora-service-detail__secondary-scene"
          role="group"
          aria-label="Imagen complementaria del servicio"
        >
          <ServiceVisual visual={visual} context="detail-secondary" />
        </div>
      )}
      {actions.length > 0 && (
        <section class="viora-service-actions" aria-labelledby="viora-service-actions-title">
          <p class="viora-service-detail__eyebrow">El próximo paso</p>
          <h2 id="viora-service-actions-title">Elegí cómo continuar.</h2>
          <ActionList idPrefix={service.slug} actions={actions} />
        </section>
      )}
    </Container>
  </section>
</VioraSiteLayout>
