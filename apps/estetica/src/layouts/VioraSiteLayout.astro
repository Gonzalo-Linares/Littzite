---
import BaseLayout from '@littzite/ui/BaseLayout.astro';
import SiteHeader from '@littzite/ui/SiteHeader.astro';
import SiteFooter from '@littzite/ui/SiteFooter.astro';
import SiteAttribution from '@littzite/ui/SiteAttribution.astro';
import { vioraAttribution } from '../site-attribution';
import Link from '@littzite/ui/Link.astro';
import ButtonLink from '@littzite/ui/ButtonLink.astro';
import type { SeoMetadata } from '@littzite/content-schema';
import VioraInstagramLink from '../components/VioraInstagramLink.astro';
import { siteContent } from '../site.config';
import {
  canonicalFor,
  vioraCommercial,
  vioraPublicRelease,
  vioraStructuredData,
} from '../viora-release.ts';
import '../styles/viora.css';

interface Props {
  seo: SeoMetadata;
  indexable?: boolean;
}

const { seo, indexable = true } = Astro.props;
const { site } = siteContent;
---

<BaseLayout
  locale={site.defaultLocale}
  theme={site.theme}
  seo={seo}
  noindex={!vioraPublicRelease || !indexable}
  iconHref={site.iconHref}
  bodyClass="viora-site"
  canonicalUrl={indexable ? canonicalFor(Astro.url.pathname) : undefined}
  siteName="VIORA · Estética integral"
  structuredData={indexable ? vioraStructuredData() : undefined}
>
  <SiteHeader
    slot="header"
    brand={'VIORA, est\u00e9tica integral'}
    descriptor="Tu momento, tu bienestar"
    links={[
      { label: 'Inicio', href: '/' },
      { label: 'Servicios', href: '/servicios/' },
      { label: 'VIORA', href: '/viora/' },
      { label: 'Contacto', href: '/contacto/' },
    ]}
  >
    <img
      slot="brand"
      class="viora-header-logo"
      src="/brand/viora-horizontal.png"
      width="1600"
      height="480"
      alt=""
      decoding="async"
    />
    <div slot="actions" class="viora-header-actions">
      <VioraInstagramLink className="viora-header-instagram" />
      <ButtonLink href="/reservar/" variant="primary" size="compact" className="site-header__badge">
        Turnos
      </ButtonLink>
    </div>
  </SiteHeader>

  <slot />

  <SiteFooter
    slot="footer"
    brand="VIORA"
    note="Tu momento, tu bienestar."
    meta={[
      vioraPublicRelease ? 'VIORA · Estética integral' : 'Vista previa · No indexable',
      vioraCommercial.publicLocation,
    ]}
  >
    <img
      slot="brand"
      class="viora-footer-logo"
      src="/brand/viora-palabra.png"
      width="1310"
      height="275"
      alt="VIORA"
      loading="lazy"
    />
    <SiteAttribution
      slot="attribution"
      {...vioraAttribution}
      className="viora-footer-attribution"
    />
    <div slot="secondary-links" class="viora-footer-groups">
      <nav class="viora-footer-links" aria-label="Navegación del pie de página">
        <Link href="/servicios/" className="viora-footer-link">
          Servicios
        </Link>
        <span aria-hidden="true">·</span>
        <Link href="/viora/" className="viora-footer-link">
          VIORA
        </Link>
        <span aria-hidden="true">·</span>
        <Link href="/contacto/" className="viora-footer-link">
          Contacto
        </Link>
        <span aria-hidden="true">·</span>
        <Link href="/reservar/" className="viora-footer-link">
          Turnos
        </Link>
      </nav>
      <span aria-hidden="true">·</span>
      <nav class="viora-footer-legal" aria-label="Información legal">
        <Link href="/privacidad/" className="viora-footer-link">
          Privacidad
        </Link>
        <span aria-hidden="true">·</span>
        <Link href="/terminos-y-condiciones/" className="viora-footer-link">
          Términos
        </Link>
        <span aria-hidden="true">·</span>
        <Link href="/arrepentimiento/" className="viora-footer-link">
          BOTÓN DE ARREPENTIMIENTO
        </Link>
      </nav>
    </div>
  </SiteFooter>
</BaseLayout>
