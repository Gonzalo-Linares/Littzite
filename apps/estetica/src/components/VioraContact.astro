---
import Container from '@littzite/ui/Container.astro';
import ButtonLink from '@littzite/ui/ButtonLink.astro';
import type { Location } from '@littzite/content-schema';
import VioraMap from './VioraMap.astro';
import { vioraCommercial, vioraPriceInquiryWhatsAppHref } from '../viora-release.ts';
interface Props {
  location?: Location;
  map?: { embedUrl?: string; directionsHref?: string; locationLabel?: string };
}
const { location, map } = Astro.props;
const locationLabel = location?.city ?? vioraCommercial.publicLocation;
---

<section id="contacto" class="viora-contact" aria-labelledby="viora-contact-title">
  <Container>
    <h1 id="viora-contact-title">Contacto</h1>
    <div class="viora-contact__map">
      <VioraMap embedUrl={map?.embedUrl} locationLabel={map?.locationLabel ?? locationLabel} />
      <p class="viora-contact__location">{locationLabel}</p>
      {map?.directionsHref && (
        <ButtonLink href={map.directionsHref} variant="secondary" icon="external" newTab>
          Cómo llegar
        </ButtonLink>
      )}
    </div>
    <div class="viora-contact__paths">
      <article class="viora-contact__details">
        <h2>Turnos</h2>
        <ButtonLink href="/reservar/" variant="primary" className="viora-contact__action">
          Solicitar turno
        </ButtonLink>
      </article>
      <article class="viora-contact__details">
        <h2>Consultas</h2>
        <div class="viora-contact__actions">
          {vioraPriceInquiryWhatsAppHref && (
            <ButtonLink
              href={vioraPriceInquiryWhatsAppHref}
              variant="primary"
              icon="external"
              newTab
            >
              Escribir por WhatsApp
            </ButtonLink>
          )}
          <ButtonLink
            href={vioraCommercial.instagramHref}
            variant="secondary"
            icon="external"
            newTab
          >
            Escribir por Instagram
          </ButtonLink>
        </div>
      </article>
    </div>
  </Container>
</section>
