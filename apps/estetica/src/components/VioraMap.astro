---
import GoogleMapPanel from '@littzite/ui/GoogleMapPanel.astro';

interface Props {
  embedUrl?: string;
  directionsHref?: string;
  locationLabel?: string;
}

const { embedUrl, directionsHref, locationLabel = 'Ubicación de VIORA' } = Astro.props;
---

<GoogleMapPanel
  embedUrl={embedUrl}
  directionsHref={directionsHref}
  locationLabel={locationLabel}
  directionsLabel="Ver en Google Maps"
  className="viora-map"
/>
