---
import type { Service } from '@littzite/content-schema';
import Container from '@littzite/ui/Container.astro';
import ServiceVisual from './ServiceVisual.astro';
import { resolveServiceVisual, type VioraServiceVisual } from '../service-visuals.validation';

interface Props {
  services: Service[];
  visuals: readonly VioraServiceVisual[];
}

const { services, visuals } = Astro.props;
const listedServices = services.map((service) => ({
  service,
  visual: resolveServiceVisual(visuals, service.id),
}));
const sectionId = 'catalogo-servicios';
---

<section class="viora-catalog" id={sectionId} aria-labelledby={`${sectionId}-titulo`}>
  <Container>
    <div class="viora-catalog__intro">
      <div>
        <p class="viora-catalog__eyebrow">VIORA / servicios</p>
        <h1 id={`${sectionId}-titulo`}>Nuestras experiencias.</h1>
      </div>
      <p>Cuidado pensado para distintos momentos. Conocé las propuestas de VIORA.</p>
    </div>
    <div class="viora-catalog__grid">
      {listedServices.map(({ service, visual }) => (
        <article class:list={['viora-catalog__card', { 'viora-catalog__card--visual': visual }]}>
          {visual && (
            <ServiceVisual
              visual={visual}
              context="card"
              transitionName={`viora-service-image-${service.slug}`}
            />
          )}
          <h3>
            <a
              class="viora-service-card__link"
              href={`/servicios/${service.slug}/`}
              style={`view-transition-name: viora-service-${service.slug}`}
            >
              <span>{service.displayName}</span>
              <span class="viora-service-card__explore">Ver experiencia</span>
            </a>
          </h3>
          <p>{service.description}</p>
        </article>
      ))}
    </div>
  </Container>
</section>
