---
import type { Service } from '@littzite/content-schema';
import Container from '@littzite/ui/Container.astro';
import Link from '@littzite/ui/Link.astro';
import ServiceVisual from './ServiceVisual.astro';
import { resolveServiceVisual, type VioraServiceVisual } from '../service-visuals.validation';

interface Props {
  services: Service[];
  visuals: readonly VioraServiceVisual[];
  variant: 'preview' | 'catalog';
  serviceIds?: string[];
}

const { services, visuals, variant, serviceIds } = Astro.props;
if (variant === 'preview' && !serviceIds) throw new Error('VIORA preview requires service IDs');
const listedIds = serviceIds ?? services.map(({ id }) => id);
const servicesById = new Map(services.map((service) => [service.id, service]));
const listedServices = listedIds.map((id) => {
  const service = servicesById.get(id);
  if (!service) throw new Error(`Missing service ${id} in VIORA catalog`);
  return { service, visual: resolveServiceVisual(visuals, service.id) };
});
const sectionId = variant === 'preview' ? 'alcance' : 'catalogo-servicios';
---

<section
  class:list={['viora-catalog', { 'viora-catalog--preview': variant === 'preview' }]}
  id={sectionId}
  aria-labelledby={`${sectionId}-titulo`}
>
  <Container>
    <div class="viora-catalog__intro">
      <div>
        <p class="viora-catalog__eyebrow">
          {variant === 'preview' ? 'Nuestro universo' : 'VIORA / servicios'}
        </p>
        {variant === 'preview' ? (
          <h2 id={`${sectionId}-titulo`}>Cada cuidado tiene su momento.</h2>
        ) : (
          <h1 id={`${sectionId}-titulo`}>Nuestras experiencias.</h1>
        )}
      </div>
      <p>
        {variant === 'preview'
          ? 'Conocé las líneas de VIORA y explorá cada experiencia.'
          : 'Cuidado pensado para distintos momentos. Conocé las propuestas de VIORA.'}
      </p>
      <p class="viora-catalog__visual-note">
        Las fotos son referencias ilustrativas; no identifican al equipo, el espacio ni las técnicas
        de VIORA.
      </p>
    </div>
    <div class="viora-catalog__grid">
      {listedServices.map(({ service, visual }, index) => (
        <article
          class:list={[
            'viora-catalog__card',
            { 'viora-catalog__card--visual': visual !== undefined },
          ]}
        >
          {visual && (
            <ServiceVisual
              visual={visual}
              context="card"
              transitionName={`viora-service-image-${service.slug}`}
            />
          )}
          <span class="viora-catalog__card-number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3>
            <a
              class="viora-service-card__link"
              href={`/servicios/${service.slug}/`}
              style={`view-transition-name: viora-service-${service.slug}`}
            >
              <span>{service.displayName}</span>
              <span class="viora-service-card__explore">
                Explorar experiencia <span aria-hidden="true">↗</span>
              </span>
            </a>
          </h3>
          <p>{service.description}</p>
        </article>
      ))}
    </div>
    {variant === 'preview' && (
      <Link href="/servicios/" className="viora-catalog__all-link">
        Ver todos los servicios <span aria-hidden="true">→</span>
      </Link>
    )}
  </Container>
</section>
