---
import InstagramIconLink from '@littzite/ui/InstagramIconLink.astro';
import { vioraCommercial } from '../viora-release.ts';

interface Props {
  showHandle?: boolean;
  className?: string;
}

const { showHandle = false, className = '' } = Astro.props;
const linkClassName = ['viora-instagram-link', className].filter(Boolean).join(' ');
---

<InstagramIconLink
  href={vioraCommercial.instagramHref}
  ariaLabel="VIORA en Instagram"
  className={linkClassName}
  iconClassName="viora-instagram-link__icon"
  dotClassName="viora-instagram-link__dot"
  handle="@vioramasajes.ok"
  showHandle={showHandle}
/>
