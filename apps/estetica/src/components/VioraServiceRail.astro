---
import type { Service } from '@littzite/content-schema';
import Container from '@littzite/ui/Container.astro';
import ServiceVisual from './ServiceVisual.astro';
import { resolveServiceVisual, type VioraServiceVisual } from '../service-visuals.validation';

interface Props {
  id: string;
  eyebrow?: string;
  compact?: boolean;
  reveal?: boolean;
  title: string;
  description: string;
  services: readonly Service[];
  visuals: readonly VioraServiceVisual[];
  summaries?: Readonly<Record<string, string>>;
}

const {
  id,
  eyebrow,
  title,
  description,
  services,
  visuals,
  summaries,
  compact = false,
  reveal = false,
} = Astro.props;
const pageSize = 4;
const pageCount = Math.ceil(services.length / pageSize);
---

<section
  class="viora-service-rail"
  id={id}
  aria-labelledby={`${id}-title`}
  data-service-rail
  data-page-size={pageSize}
  data-page-count={pageCount}
>
  <Container>
    <div class="viora-service-rail__heading">
      <div class="viora-service-rail__intro">
        {eyebrow && <p class="viora-service-rail__eyebrow">{eyebrow}</p>}
        <h2 id={`${id}-title`} data-viora-reveal={reveal ? 'services' : undefined}>
          {title}
        </h2>
        <p
          data-viora-reveal={reveal ? 'services' : undefined}
          style="--viora-reveal-start: 4%; --viora-reveal-end: 42%"
        >
          {description}
        </p>
      </div>
      {pageCount > 1 && (
        <div class="viora-service-rail__controls" data-service-rail-controls hidden>
          <button
            type="button"
            class="viora-service-rail__control"
            data-service-rail-previous
            aria-label="Servicios anteriores"
            disabled
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m14.5 5-7 7 7 7" />
            </svg>
          </button>
          <button
            type="button"
            class="viora-service-rail__control"
            data-service-rail-next
            aria-label="Servicios siguientes"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m9.5 5 7 7-7 7" />
            </svg>
          </button>
          <span
            class="viora-service-rail__status"
            data-service-rail-status
            aria-live="polite"
          ></span>
        </div>
      )}
    </div>
    <div class="viora-service-rail__viewport" data-service-rail-viewport>
      <div class="viora-service-rail__track">
        {services.map((service, index) => {
          const visual = resolveServiceVisual(visuals, service.id);
          return (
            <article
              class="viora-service-rail__card"
              data-service-rail-card
              data-viora-reveal={reveal ? 'services' : undefined}
              style={`--viora-reveal-start: ${32 + (index % pageSize) * 4}%; --viora-reveal-end: ${70 + (index % pageSize) * 4}%`}
            >
              <a class="viora-service-rail__link" href={`/servicios/${service.slug}/`}>
                {visual && (
                  <div class="viora-service-rail__media">
                    <ServiceVisual
                      visual={visual}
                      context="card"
                      transitionName={`viora-service-image-${service.slug}`}
                    />
                  </div>
                )}
                <div class="viora-service-rail__copy">
                  <h3>{service.displayName}</h3>
                  {!compact && <p>{summaries?.[service.id] ?? service.description}</p>}
                  <span class="viora-service-rail__affordance">Ver servicio</span>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </Container>
</section>

<script>
  import { railScrollState, railTargetOffset } from '../viora-service-rail';
  const cleanups: Array<() => void> = [];
  const cleanup = () => cleanups.splice(0).forEach((stop) => stop());
  function initServiceRails() {
    cleanup();
    for (const rail of document.querySelectorAll<HTMLElement>('[data-service-rail]')) {
      if (rail.dataset.railInitialized) continue;
      rail.dataset.railInitialized = 'true';
      const viewport = rail.querySelector<HTMLElement>('[data-service-rail-viewport]');
      const cards = [...rail.querySelectorAll<HTMLElement>('[data-service-rail-card]')];
      const controls = rail.querySelector<HTMLElement>('[data-service-rail-controls]');
      const previous = rail.querySelector<HTMLButtonElement>('[data-service-rail-previous]');
      const next = rail.querySelector<HTMLButtonElement>('[data-service-rail-next]');
      const status = rail.querySelector<HTMLElement>('[data-service-rail-status]');
      if (!viewport || !controls || !previous || !next || !cards.length) continue;
      const desktop = window.matchMedia('(min-width: 961px)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const update = () => {
        const state = railScrollState(
          viewport.scrollLeft,
          viewport.clientWidth,
          viewport.scrollWidth,
        );
        controls.hidden = !desktop.matches || !state.overflow;
        previous.disabled = !state.previous;
        next.disabled = !state.next;
        previous.hidden = !state.previous;
        next.hidden = !state.next;
        if (status) status.textContent = state.overflow ? 'Más servicios disponibles' : '';
      };
      const move = (direction: -1 | 1) => {
        const offsets = cards.map(
          (card) =>
            card.getBoundingClientRect().left -
            viewport.getBoundingClientRect().left +
            viewport.scrollLeft,
        );
        viewport.scrollTo({
          left: railTargetOffset(viewport.scrollLeft, viewport.clientWidth, offsets, direction),
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
        });
      };
      const onPrevious = () => move(-1);
      const onNext = () => move(1);
      previous.addEventListener('click', onPrevious);
      next.addEventListener('click', onNext);
      viewport.addEventListener('scroll', update, { passive: true });
      desktop.addEventListener('change', update);
      const resize = typeof ResizeObserver === 'function' ? new ResizeObserver(update) : undefined;
      if (resize) resize.observe(viewport);
      else window.addEventListener('resize', update, { passive: true });
      cleanups.push(() => {
        resize?.disconnect();
        previous.removeEventListener('click', onPrevious);
        next.removeEventListener('click', onNext);
        viewport.removeEventListener('scroll', update);
        desktop.removeEventListener('change', update);
        window.removeEventListener('resize', update);
        delete rail.dataset.railInitialized;
      });
      update();
    }
  }
  initServiceRails();
  document.addEventListener('astro:page-load', initServiceRails);
  document.addEventListener('astro:before-swap', cleanup);
</script>
