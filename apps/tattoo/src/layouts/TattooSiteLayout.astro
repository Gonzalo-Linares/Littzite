---
import BaseLayout from '@littzite/ui/BaseLayout.astro';
import TattooHeader from '../components/TattooHeader.astro';
import Link from '@littzite/ui/Link.astro';
import SiteAttribution from '@littzite/ui/SiteAttribution.astro';
import { tattooBrand } from '../brand.config';
import { siteContent } from '../site.config';
import {
  tattooCanonicalFor,
  tattooPublicRelease,
  tattooStructuredData,
} from '../release-readiness.ts';
import '../styles/juanjo.css';
import '../styles/production-content.css';
import TattooContactActions from '../components/TattooContactActions.astro';

interface Props {
  title: string;
  description: string;
  indexable?: boolean;
}

const { title, description, indexable = true } = Astro.props;
const { site } = siteContent;
---

<BaseLayout
  locale={site.defaultLocale}
  theme={site.theme}
  seo={{ title, description }}
  noindex={!tattooPublicRelease || !indexable}
  canonicalUrl={indexable ? tattooCanonicalFor(Astro.url.pathname) : undefined}
  iconHref={site.iconHref}
  siteName={tattooBrand.name}
  structuredData={indexable ? tattooStructuredData() : undefined}
  bodyClass="juanjo-site"
>
  <Fragment slot="head">
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/oni-icon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/oni-icon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/oni-icon-180.png" />
  </Fragment>
  <TattooHeader slot="header" />

  <slot />
  <TattooContactActions />

  <footer slot="footer" class="site-footer">
    <div class="container site-footer__inner">
      <span class="tattoo-footer-brand">
        <img
          src={tattooBrand.marks.signature.src}
          width="1774"
          height="887"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </span>
      <nav class="tattoo-footer-nav" aria-label="Navegación del pie de página">
        <Link className="tattoo-footer-nav__link" href="/">
          Inicio
        </Link>
        <Link className="tattoo-footer-nav__link" href="/trabajos/">
          Tatuajes
        </Link>
        <Link className="tattoo-footer-nav__link" href="/guia/">
          Guía
        </Link>
        <Link className="tattoo-footer-nav__link" href="/contacto/">
          Contacto
        </Link>
        <Link className="tattoo-footer-nav__link" href="/guia/#preguntas">
          Preguntas frecuentes
        </Link>
      </nav>
      <SiteAttribution
        label={tattooBrand.attribution.label}
        brand={tattooBrand.attribution.brand}
        href={tattooBrand.attribution.href}
        logoSrc={tattooBrand.attribution.logoSrc}
        className="tattoo-attribution"
      />
    </div>
    <div class="container site-footer__bottom tattoo-footer-bottom">
      <p>© {new Date().getFullYear()} Juanjo Tattoo Studio. Todos los derechos reservados.</p>
      <nav class="tattoo-footer-legal" aria-label="Información legal">
        <Link className="tattoo-footer-legal__link" href="/privacidad/">
          Privacidad
        </Link>
        <Link className="tattoo-footer-legal__link" href="/terminos-y-condiciones/">
          Términos
        </Link>
        <Link className="tattoo-footer-legal__link" href="/arrepentimiento/">
          Arrepentimiento
        </Link>
      </nav>
    </div>
  </footer>
</BaseLayout>
