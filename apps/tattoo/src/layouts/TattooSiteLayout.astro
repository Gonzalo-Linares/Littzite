---
import BaseLayout from '@littzite/ui/BaseLayout.astro';
import SiteHeader from '@littzite/ui/SiteHeader.astro';
import SiteFooter from '@littzite/ui/SiteFooter.astro';
import Link from '@littzite/ui/Link.astro';
import SiteAttribution from '@littzite/ui/SiteAttribution.astro';
import { tattooBrand } from '../brand.config';
import { siteContent } from '../site.config';
import '../styles/juanjo.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const { site } = siteContent;
const socialHref = tattooBrand.social.instagram;
---

<BaseLayout
  locale={site.defaultLocale}
  theme={site.theme}
  seo={{ title, description }}
  noindex={true}
  iconHref={site.iconHref}
  siteName={tattooBrand.name}
  bodyClass="juanjo-site"
>
  <SiteHeader
    slot="header"
    brand={tattooBrand.name}
    descriptor=""
    links={[
      { label: 'Inicio', href: '/' },
      { label: 'Trabajos', href: '/trabajos/' },
      { label: 'Estudio', href: '/estudio/' },
      { label: 'Contacto', href: '/contacto/' },
    ]}
    badge={{ label: tattooBrand.social.handle, href: socialHref }}
  >
    <picture slot="brand" class="tattoo-brand-mark" aria-hidden="true">
      <source media="(max-width: 600px)" srcset={tattooBrand.marks.jt.src} type="image/png" />
      <img
        class="tattoo-brand-mark__image"
        src={tattooBrand.marks.signature.src}
        width="1774"
        height="887"
        alt=""
        loading="eager"
        decoding="async"
      />
    </picture>
  </SiteHeader>

  <slot />

  <SiteFooter
    slot="footer"
    brand={tattooBrand.name}
    note="Tinta con carácter."
    meta={['Vista previa · No admite reservas todavía', tattooBrand.name.toUpperCase()]}
  >
    <span slot="brand" class="tattoo-footer-brand">
      <img
        src={tattooBrand.marks.signature.src}
        width="1774"
        height="887"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </span>
    <nav slot="links" class="tattoo-footer-nav" aria-label="Navegación del pie de página">
      <Link className="tattoo-footer-nav__link" href="/">
        Inicio
      </Link>
      <Link className="tattoo-footer-nav__link" href="/trabajos/">
        Trabajos
      </Link>
      <Link className="tattoo-footer-nav__link" href="/estudio/">
        Estudio
      </Link>
      <Link className="tattoo-footer-nav__link" href="/contacto/">
        Contacto
      </Link>
      <Link className="tattoo-footer-nav__link" href={socialHref}>
        Instagram
      </Link>
    </nav>
    <SiteAttribution
      slot="attribution"
      label={tattooBrand.attribution.label}
      brand={tattooBrand.attribution.brand}
      href={tattooBrand.attribution.href}
      logoSrc={tattooBrand.attribution.logoSrc}
      className="tattoo-attribution"
    />
  </SiteFooter>
</BaseLayout>
