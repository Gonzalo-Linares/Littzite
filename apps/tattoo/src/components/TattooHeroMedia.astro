---
import { tattooBrand } from '../brand.config';
const { media = tattooBrand.heroMedia } = Astro.props;
if (!media.src?.startsWith('/') || media.src.startsWith('//') || !media.alt)
  throw new Error('Tattoo hero needs an approved local image and description.');
---

<div class="tattoo-hero-media" aria-hidden="true">
  <img
    class="tattoo-hero-media__background"
    src={media.src}
    width={media.width ?? tattooBrand.heroMedia.width}
    height={media.height ?? tattooBrand.heroMedia.height}
    alt=""
    fetchpriority="high"
    decoding="async"
  />
</div>
