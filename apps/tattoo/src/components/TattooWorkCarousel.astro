---
import { tattooBrand } from '../brand.config';
import type { TattooPortfolioItem } from '../portfolio';

interface Props {
  items: readonly TattooPortfolioItem[];
  id?: string;
}

const { items, id = 'trabajos-carousel' } = Astro.props;
const canMove = items.length > 1;
---

<section
  class="tattoo-carousel"
  id={id}
  aria-label="Trabajos de Juanjo Tattoo Studio"
  data-tattoo-carousel
  data-count={items.length}
>
  {items.length > 0 ? (
    <>
      <div
        class="tattoo-carousel__viewport"
        role="group"
        tabindex="0"
        aria-label="Carrusel de trabajos. Usá las flechas izquierda y derecha para recorrer los trabajos."
      >
        <div class="tattoo-carousel__track">
          {items.map((item, index) => (
            <figure class="tattoo-carousel__item" data-slide-index={index}>
              <div class="tattoo-carousel__image-wrap">
                <img
                  src={item.image.src}
                  alt={item.alt}
                  width={item.image.width}
                  height={item.image.height}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <figcaption>
                <span class="tattoo-carousel__number">{String(index + 1).padStart(2, '0')}</span>
                <span>{item.title}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
      {canMove && (
        <div class="tattoo-carousel__controls" role="group" aria-label="Controles de trabajos">
          <button type="button" data-carousel-prev aria-label="Trabajo anterior">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m14.5 5-7 7 7 7" />
            </svg>
          </button>
          <button type="button" data-carousel-next aria-label="Trabajo siguiente">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m9.5 5 7 7-7 7" />
            </svg>
          </button>
        </div>
      )}
    </>
  ) : (
    <div class="tattoo-carousel__empty">
      <div class="tattoo-carousel__empty-mark">
        <img
          src={tattooBrand.marks.signature.src}
          width={tattooBrand.marks.signature.width}
          height={tattooBrand.marks.signature.height}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
        <span>OBRA · OFICIO · IDENTIDAD</span>
      </div>
      <div class="tattoo-carousel__empty-copy">
        <p class="tattoo-eyebrow">TRABAJOS DEL ESTUDIO</p>
        <h3>TRABAJOS</h3>
        <p>Una selección de tatuajes y estilos.</p>
        <a class="tattoo-text-link" href="/trabajos/">
          Explorar trabajos <span aria-hidden="true">↗</span>
        </a>
      </div>
      <img
        class="tattoo-carousel__seal"
        src={tattooBrand.marks.seal.src}
        width={tattooBrand.marks.seal.width}
        height={tattooBrand.marks.seal.height}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
</section>

{canMove && <script>
  document.querySelectorAll<HTMLElement>('[data-tattoo-carousel]').forEach((carousel) => {
    const viewport = carousel.querySelector<HTMLElement>('.tattoo-carousel__viewport');
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-slide-index]')];
    const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!viewport || !previous || !next || slides.length < 2) return;

    let activeIndex = 0;

    const update = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) =>
        slide.classList.toggle('is-active', slideIndex === activeIndex),
      );
      const target = slides[activeIndex];
      if (target) {
        viewport.scrollTo({
          left: target.offsetLeft - (viewport.clientWidth - target.offsetWidth) / 2,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'auto'
            : 'smooth',
        });
      }
    };

    const syncActive = () => {
      const center = viewport.scrollLeft + viewport.clientWidth / 2;
      activeIndex = slides.reduce((closest, slide, index) => {
        const slideCenter = slide.offsetLeft + slide.offsetWidth / 2;
        return Math.abs(slideCenter - center) <
          Math.abs(slides[closest].offsetLeft + slides[closest].offsetWidth / 2 - center)
          ? index
          : closest;
      }, 0);
      slides.forEach((slide, slideIndex) =>
        slide.classList.toggle('is-active', slideIndex === activeIndex),
      );
    };

    previous.addEventListener('click', () => {
      update(activeIndex - 1);
    });
    next.addEventListener('click', () => {
      update(activeIndex + 1);
    });
    viewport.addEventListener('scroll', syncActive, { passive: true });
    viewport.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        update(activeIndex - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        update(activeIndex + 1);
      }
    });
    syncActive();
  });
</script>}
