---
import { tattooBrand } from '../brand.config';
import type { TattooPortfolioItem } from '../portfolio';

interface Props {
  items: readonly TattooPortfolioItem[];
  id?: string;
}

const { items, id = 'trabajos-carousel' } = Astro.props;
const canMove = items.length > 1;
---

<section
  class="tattoo-carousel"
  id={id}
  aria-label="Trabajos de Juanjo Tattoo Studio"
  data-tattoo-carousel
  data-count={items.length}
>
  {items.length > 0 ? (
    <>
      <div
        class="tattoo-carousel__viewport"
        role="group"
        tabindex="0"
        aria-label="Carrusel de trabajos. Usá las flechas izquierda y derecha para recorrer los trabajos."
      >
        <div class="tattoo-carousel__track">
          {[0, 1, 2].map((copy) =>
            items.map((item, index) => (
              <figure
                class:list={['tattoo-carousel__item', copy !== 1 && 'is-clone']}
                data-slide-index={copy * items.length + index}
                data-logical-index={index}
                data-copy={copy}
                aria-hidden={copy !== 1 ? 'true' : undefined}
              >
                <div class="tattoo-carousel__image-wrap">
                  <img
                    src={item.image.src}
                    alt={copy === 1 ? item.alt : ''}
                    width={item.image.width}
                    height={item.image.height}
                    loading={copy === 1 && index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </div>
                <figcaption>
                  <span class="tattoo-carousel__number">{String(index + 1).padStart(2, '0')}</span>
                  <span>{item.title}</span>
                </figcaption>
              </figure>
            )),
          )}
        </div>
      </div>
      {canMove && (
        <div class="tattoo-carousel__controls" role="group" aria-label="Controles de trabajos">
          <button type="button" data-carousel-prev aria-label="Trabajo anterior">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m14.5 5-7 7 7 7" />
            </svg>
          </button>
          <button type="button" data-carousel-next aria-label="Trabajo siguiente">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m9.5 5 7 7-7 7" />
            </svg>
          </button>
        </div>
      )}
    </>
  ) : (
    <div class="tattoo-carousel__empty">
      <div class="tattoo-carousel__empty-mark">
        <img
          src={tattooBrand.marks.signature.src}
          width={tattooBrand.marks.signature.width}
          height={tattooBrand.marks.signature.height}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
        <span>OBRA · OFICIO · IDENTIDAD</span>
      </div>
      <div class="tattoo-carousel__empty-copy">
        <p class="tattoo-eyebrow">TRABAJOS DEL ESTUDIO</p>
        <h3>TRABAJOS</h3>
        <p>Una selección de tatuajes y estilos.</p>
        <a class="tattoo-text-link" href="/trabajos/">
          Explorar trabajos <span aria-hidden="true">↗</span>
        </a>
      </div>
      <img
        class="tattoo-carousel__seal"
        src={tattooBrand.marks.seal.src}
        width={tattooBrand.marks.seal.width}
        height={tattooBrand.marks.seal.height}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
</section>

{canMove && <script>
  document.querySelectorAll<HTMLElement>('[data-tattoo-carousel]').forEach((carousel) => {
    const viewport = carousel.querySelector<HTMLElement>('.tattoo-carousel__viewport');
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-slide-index]')];
    const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!viewport || !previous || !next || slides.length < 2) return;

    const itemCount = Number(carousel.dataset.count);
    if (!Number.isFinite(itemCount) || itemCount < 2 || slides.length !== itemCount * 3) return;
    let logicalIndex = 0;
    let physicalIndex = itemCount;
    let settleTimer = 0;
    let queuedSteps = 0;
    let moving = false;

    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const centerSlide = (index: number, behavior: ScrollBehavior) => {
      const slide = slides[index];
      if (!slide) return;
      const viewportRect = viewport.getBoundingClientRect();
      const slideRect = slide.getBoundingClientRect();
      viewport.scrollTo({
        left:
          viewport.scrollLeft +
          slideRect.left +
          slideRect.width / 2 -
          viewportRect.left -
          viewport.clientWidth / 2,
        behavior,
      });
    };
    const markActive = (index: number) => {
      logicalIndex = Number(slides[index]?.dataset.logicalIndex ?? 0);
      physicalIndex = index;
      carousel.dataset.activeIndex = String(logicalIndex);
      slides.forEach((slide, slideIndex) =>
        slide.classList.toggle('is-active', slideIndex === index),
      );
    };
    const closestPhysicalIndex = () => {
      const viewportRect = viewport.getBoundingClientRect();
      const center = viewportRect.left + viewport.clientWidth / 2;
      return slides.reduce(
        (closest, slide, index) => {
          const rect = slide.getBoundingClientRect();
          const distance = Math.abs(rect.left + rect.width / 2 - center);
          return distance < closest.distance ? { index, distance } : closest;
        },
        { index: 0, distance: Number.POSITIVE_INFINITY },
      ).index;
    };
    const move = (step: number) => {
      const targetIndex = physicalIndex + step;
      if (targetIndex < 0 || targetIndex >= slides.length) return;
      moving = true;
      markActive(targetIndex);
      centerSlide(targetIndex, reducedMotion() ? 'auto' : 'smooth');
      if (reducedMotion()) settle();
    };
    const requestMove = (step: number) => {
      if (moving) {
        queuedSteps += step;
        return;
      }
      move(step);
    };
    const settle = () => {
      window.clearTimeout(settleTimer);
      const nearest = closestPhysicalIndex();
      markActive(nearest);
      if (nearest < itemCount || nearest >= itemCount * 2) {
        const recentered = nearest < itemCount ? nearest + itemCount : nearest - itemCount;
        markActive(recentered);
        centerSlide(recentered, 'auto');
      }
      moving = false;
      if (queuedSteps !== 0) {
        const step = Math.sign(queuedSteps);
        queuedSteps -= step;
        move(step);
      }
    };

    previous.addEventListener('click', () => requestMove(-1));
    next.addEventListener('click', () => requestMove(1));
    viewport.addEventListener(
      'scroll',
      () => {
        window.clearTimeout(settleTimer);
        settleTimer = window.setTimeout(settle, 140);
      },
      { passive: true },
    );
    viewport.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        requestMove(-1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        requestMove(1);
      }
    });
    markActive(physicalIndex);
    centerSlide(physicalIndex, 'auto');
  });
</script>}
