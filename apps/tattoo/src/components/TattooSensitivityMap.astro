<section
  class="tattoo-guide-section tattoo-sensitivity"
  id="sensibilidad"
  aria-labelledby="sensitivity-title"
>
  <div class="container">
    <div class="tattoo-guide-heading">
      <p class="tattoo-eyebrow">02 / SENSIBILIDAD</p>
      <h2 id="sensitivity-title">Sensibilidad orientativa por zona</h2>
      <p>Una referencia visual para conversar la ubicación antes de definir el diseño.</p>
    </div>
    <div class="tattoo-sensitivity__layout">
      <div class="tattoo-body-maps">
        <figure class="tattoo-sensitivity-figure">
          <div class="tattoo-body-photo tattoo-body-photo--front">
            <img
              src="/guide/body-front.webp"
              width="1024"
              height="1536"
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
            <span
              class="tattoo-heat tattoo-heat--low tattoo-heat--front-shoulders"
              aria-hidden="true"
            ></span>
            <span
              class="tattoo-heat tattoo-heat--medium tattoo-heat--front-arms tattoo-heat--left"
              aria-hidden="true"
            ></span>
            <span
              class="tattoo-heat tattoo-heat--medium tattoo-heat--front-arms tattoo-heat--right"
              aria-hidden="true"
            ></span>
            <span
              class="tattoo-heat tattoo-heat--high tattoo-heat--front-ribs"
              aria-hidden="true"
            ></span>
            <span
              class="tattoo-heat tattoo-heat--high tattoo-heat--front-elbows tattoo-heat--left"
              aria-hidden="true"
            ></span>
            <span
              class="tattoo-heat tattoo-heat--high tattoo-heat--front-elbows tattoo-heat--right"
              aria-hidden="true"
            ></span>
            <span
              class="tattoo-heat tattoo-heat--medium tattoo-heat--front-thighs tattoo-heat--left"
              aria-hidden="true"
            ></span>
            <span
              class="tattoo-heat tattoo-heat--medium tattoo-heat--front-thighs tattoo-heat--right"
              aria-hidden="true"
            ></span>
            <span
              class="tattoo-heat tattoo-heat--high tattoo-heat--front-ankles tattoo-heat--left"
              aria-hidden="true"
            ></span>
            <span
              class="tattoo-heat tattoo-heat--high tattoo-heat--front-ankles tattoo-heat--right"
              aria-hidden="true"
            ></span>
          </div>
          <figcaption>Frente</figcaption>
        </figure>
        <figure class="tattoo-sensitivity-figure">
          <div class="tattoo-body-photo tattoo-body-photo--back">
            <img
              src="/guide/body-back.webp"
              width="1024"
              height="1536"
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
            <span
              class="tattoo-heat tattoo-heat--low tattoo-heat--back-shoulders"
              aria-hidden="true"
            ></span>
            <span
              class="tattoo-heat tattoo-heat--medium tattoo-heat--back-arms tattoo-heat--left"
              aria-hidden="true"
            ></span>
            <span
              class="tattoo-heat tattoo-heat--medium tattoo-heat--back-arms tattoo-heat--right"
              aria-hidden="true"
            ></span>
            <span
