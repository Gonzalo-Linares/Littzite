              aria-hidden="true"
            ></span>
            <span
              class="tattoo-heat tattoo-heat--medium tattoo-heat--back-thighs tattoo-heat--left"
              aria-hidden="true"
            ></span>
            <span
              class="tattoo-heat tattoo-heat--medium tattoo-heat--back-thighs tattoo-heat--right"
              aria-hidden="true"
            ></span>
            <span
