---
import TattooLegalPage from '../components/TattooLegalPage.astro';
import TattooSiteLayout from '../layouts/TattooSiteLayout.astro';
import Link from '@littzite/ui/Link.astro';
import { tattooLegal, tattooLegalEmailHref } from '../release-readiness.ts';
---

<TattooSiteLayout
  title="Términos y condiciones | Juanjo Tattoo Studio"
  description="Información general sobre el uso del sitio de Juanjo Tattoo Studio."
>
  <TattooLegalPage
    title="Términos y condiciones"
    description="Información general de uso del sitio y de los servicios externos enlazados."
  >
    <section>
      <h2>Prestador y contacto</h2>
      <dl>
        <dt>Prestador</dt>
        <dd>{tattooLegal.providerName}</dd>
        <dt>CUIT</dt>
        <dd>{tattooLegal.taxId}</dd>
        <dt>Domicilio legal</dt>
        <dd>{tattooLegal.legalDomicile}</dd>
        <dt>Contacto</dt>
        <dd>
          {tattooLegalEmailHref ? (
            <Link href={tattooLegalEmailHref}>{tattooLegal.contactEmail}</Link>
          ) : (
            tattooLegal.contactEmail
          )}
          <br />
          {tattooLegal.phone}
        </dd>
      </dl>
    </section>
    <section>
      <h2>Uso del sitio</h2>
      <p>
        El sitio ofrece información sobre el estudio y enlaces para iniciar una consulta o acceder a
        servicios externos. El contenido informativo no reemplaza la conversación sobre el alcance y
        las condiciones de cada proyecto.
      </p>
    </section>
    <section>
      <h2>Servicios externos</h2>
      <p>
        Los enlaces a Cal.com, Instagram y Google Maps conducen a servicios gestionados por
        terceros, sujetos a sus propias condiciones y políticas de privacidad.
      </p>
    </section>
    <section>
      <h2>Alcance y derechos</h2>
      <p>
        Este sitio es informativo. Las consultas o reservas pueden continuar en servicios externos;
        sus condiciones no reemplazan la información que corresponda para cada proyecto. Nada de lo
        indicado aquí limita derechos irrenunciables que puedan corresponder.
      </p>
    </section>
  </TattooLegalPage>
</TattooSiteLayout>
