---
import Link from '@littzite/ui/Link.astro';
import TattooSiteLayout from '../layouts/TattooSiteLayout.astro';
import { tattooBrand } from '../brand.config';
---

<TattooSiteLayout
  title="Contacto | Juanjo Tattoo Studio"
  description="Canal oficial de contacto de Juanjo Tattoo Studio en Instagram."
>
  <section class="tattoo-contact-page" aria-labelledby="contact-title">
    <div class="container tattoo-contact-page__inner">
      <p class="tattoo-eyebrow">CONTACTO OFICIAL</p>
      <h1 id="contact-title">Contanos tu idea.</h1>
      <p class="tattoo-contact-page__lead">
        Para conocer el trabajo publicado y comunicarte con Juanjo, visitá su perfil oficial.
      </p>
      <Link className="tattoo-instagram-link" href={tattooBrand.social.instagram}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
          <circle cx="12" cy="12" r="4" />
          <circle class="tattoo-instagram-link__dot" cx="17.6" cy="6.8" r="1" />
        </svg>
        <span>{tattooBrand.social.handle}</span>
        <span class="tattoo-instagram-link__arrow" aria-hidden="true">
          ↗
        </span>
      </Link>
      <p class="tattoo-contact-page__note">El enlace abre Instagram, un servicio externo.</p>
    </div>
  </section>
</TattooSiteLayout>
