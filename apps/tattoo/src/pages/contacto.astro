---
import ButtonLink from '@littzite/ui/ButtonLink.astro';
import TattooSiteLayout from '../layouts/TattooSiteLayout.astro';
import TattooInstagramLink from '../components/TattooInstagramLink.astro';
import { tattooActions } from '../brand.config';
---

<TattooSiteLayout
  title="Turnos y consultas | Juanjo Tattoo Studio"
  description="Coordiná turnos y consultas con Juanjo Tattoo Studio a través del perfil oficial de Instagram."
>
  <article class="tattoo-contact-page">
    <header class="tattoo-contact-hero">
      <div class="container">
        <p class="tattoo-eyebrow">CANAL OFICIAL</p>
        <h1>Turnos y consultas</h1>
        <p>El primer paso es conversar tu idea con Juanjo.</p>
      </div>
    </header>
    <section class="container tattoo-contact-paths" aria-label="Opciones de contacto">
      <article class="tattoo-contact-path" id="turnos">
        <span class="tattoo-contact-path__number">01 / TURNOS</span>
        <h2>Sacar turno</h2>
        <p>Escribile a Juanjo por Instagram para coordinar el próximo paso.</p>
        <TattooInstagramLink showHandle className="tattoo-contact-path__instagram" />
        <ButtonLink href={tattooActions.instagramHref} variant="primary" icon="external">
          Sacar turno
        </ButtonLink>
      </article>
      <article class="tattoo-contact-path">
        <span class="tattoo-contact-path__number">02 / PROYECTOS PERSONALIZADOS</span>
        <h2>Consultar por Instagram</h2>
        <p>Los proyectos de mayor escala requieren una conversación y un presupuesto previo.</p>
        <ButtonLink href={tattooActions.consultHref} variant="secondary" icon="external">
          Consultar por Instagram
        </ButtonLink>
      </article>
    </section>
    <p class="container tattoo-contact-note">
      El enlace abre Instagram, un servicio externo. No hay una agenda automática configurada.
    </p>
  </article>
</TattooSiteLayout>
