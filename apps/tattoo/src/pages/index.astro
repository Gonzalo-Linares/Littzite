---
import ButtonLink from '@littzite/ui/ButtonLink.astro';
import TattooSiteLayout from '../layouts/TattooSiteLayout.astro';
import TattooHeroMedia from '../components/TattooHeroMedia.astro';
import TattooInstagramLink from '../components/TattooInstagramLink.astro';
import TattooWorkCarousel from '../components/TattooWorkCarousel.astro';
import { tattooActions } from '../brand.config';
import { featuredTattooWorks } from '../portfolio';
---

<TattooSiteLayout
  title="Juanjo Tattoo Studio | Tu próximo tatuaje empieza acá"
  description="Explorá trabajos, elegí el estilo que te representa y sacá tu turno con Juanjo Tattoo Studio en San Juan."
>
  <section class="tattoo-home-hero" aria-labelledby="home-hero-title">
    <div class="container tattoo-home-hero__grid">
      <div class="tattoo-home-hero__copy">
        <h1 id="home-hero-title">Tu próximo tatuaje empieza acá.</h1>
        <div class="tattoo-home-hero__actions">
          <ButtonLink href={tattooActions.turnsHref} variant="primary" icon="external">
            Sacar turno
          </ButtonLink>
          <ButtonLink href="/trabajos/" variant="secondary">
            Ver trabajos
          </ButtonLink>
        </div>
      </div>
      <TattooHeroMedia />
    </div>
  </section>

  <section class="tattoo-work-section" id="trabajos" aria-labelledby="home-work-title">
    <div class="container">
      <div class="tattoo-section-heading tattoo-section-heading--split">
        <div>
          <h2 id="home-work-title">Trabajos destacados</h2>
          <p>Una selección de trabajos del estudio.</p>
        </div>
        <div class="tattoo-work-section__actions">
          <ButtonLink href="/trabajos/" variant="secondary" size="compact">
            Ver todos los trabajos
          </ButtonLink>
          <TattooInstagramLink showHandle={false} className="tattoo-inline-instagram">
            Ver Instagram
          </TattooInstagramLink>
        </div>
      </div>
      <TattooWorkCarousel items={featuredTattooWorks} id="inicio-trabajos-carousel" />
    </div>
  </section>
</TattooSiteLayout>
<script>
  // CSS owns visibility from the first paint; this only freezes completed reveals.
  const section = document.querySelector<HTMLElement>('.tattoo-work-section');
  if (section && CSS.supports('animation-timeline: view()')) {
    let frame = 0;
    const cleanup = () => {
      window.removeEventListener('scroll', scheduleCheck);
      window.removeEventListener('scrollend', scheduleCheck);
      window.cancelAnimationFrame(frame);
    };
    const freezeCompletedReveal = () => {
      frame = 0;
      const reveals = section.querySelectorAll<HTMLElement>(
        '.tattoo-section-heading, .tattoo-carousel, .tattoo-carousel__image-wrap',
      );
      if (
        section.getBoundingClientRect().top < window.innerHeight &&
        [...reveals].every((reveal) => getComputedStyle(reveal).opacity === '1')
      ) {
        section.dataset.revealed = 'true';
        cleanup();
      }
    };
    const scheduleCheck = () => {
      if (!frame) frame = window.requestAnimationFrame(freezeCompletedReveal);
    };
    window.addEventListener('scroll', scheduleCheck, { passive: true });
    window.addEventListener('scrollend', scheduleCheck, { passive: true });
    scheduleCheck();
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }
</script>
