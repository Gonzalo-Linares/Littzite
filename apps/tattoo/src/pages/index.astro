---
import ButtonLink from '@littzite/ui/ButtonLink.astro';
import TattooSiteLayout from '../layouts/TattooSiteLayout.astro';
import TattooHeroMedia from '../components/TattooHeroMedia.astro';
import TattooInstagramLink from '../components/TattooInstagramLink.astro';
import TattooWorkCarousel from '../components/TattooWorkCarousel.astro';
import { tattooActions, tattooBrand } from '../brand.config';
import { tattooPortfolio } from '../portfolio';
---

<TattooSiteLayout
  title="Juanjo Tattoo Studio | Tu próxima pieza empieza acá"
  description="Explorá trabajos, definí tu idea y coordiná el próximo paso con Juanjo Tattoo Studio en San Juan."
>
  <section class="tattoo-home-hero" aria-labelledby="home-hero-title">
    <div class="container tattoo-home-hero__grid">
      <div class="tattoo-home-hero__copy">
        <p class="tattoo-eyebrow">
          <span aria-hidden="true"></span>Tinta con carácter
        </p>
        <h1 id="home-hero-title">
          Tu próxima pieza <span>empieza acá.</span>
        </h1>
        <p class="tattoo-home-hero__lead">
          Explorá trabajos, definí tu idea y coordiná el próximo paso con Juanjo.
        </p>
        <div class="tattoo-home-hero__actions">
          <ButtonLink href={tattooActions.turnsHref} variant="primary">
            Sacar turno
          </ButtonLink>
          <ButtonLink href="/trabajos/" variant="secondary">
            Explorar trabajos
          </ButtonLink>
        </div>
        <p class="tattoo-home-hero__location">
          Juanjo Tattoo Studio <span aria-hidden="true">·</span> San Juan, Argentina
        </p>
      </div>
      <TattooHeroMedia media={tattooBrand.heroMedia} />
    </div>
  </section>

  <section class="tattoo-work-section" id="trabajos" aria-labelledby="home-work-title">
    <div class="container">
      <div class="tattoo-section-heading tattoo-section-heading--split">
        <div>
          <p class="tattoo-eyebrow">PIEZAS SELECCIONADAS</p>
          <h2 id="home-work-title">Trabajos</h2>
        </div>
        <a class="tattoo-text-link" href="/trabajos/">
          Ver trabajos <span aria-hidden="true">↗</span>
        </a>
      </div>
      <TattooWorkCarousel items={tattooPortfolio} id="inicio-trabajos-carousel" />
    </div>
  </section>

  <section class="tattoo-before-ink" id="antes-de-la-tinta" aria-labelledby="before-ink-title">
    <div class="container">
      <div class="tattoo-section-heading tattoo-before-ink__heading">
        <p class="tattoo-eyebrow">CADA PIEZA EMPIEZA ANTES</p>
        <h2 id="before-ink-title">Antes de la tinta</h2>
      </div>
      <div class="tattoo-before-ink__grid">
        <article class="tattoo-before-card">
          <span class="tattoo-before-card__mark" aria-hidden="true">
            01
          </span>
          <p class="tattoo-eyebrow">LA IDEA</p>
          <h3>Referencia e intención</h3>
          <p>Compartí qué te inspira y el estilo que imaginás.</p>
        </article>
        <article class="tattoo-before-card tattoo-before-card--featured">
          <span class="tattoo-before-card__mark" aria-hidden="true">
            02
          </span>
          <p class="tattoo-eyebrow">TAMAÑO Y UBICACIÓN</p>
          <h3>La escala cambia la lectura</h3>
          <p>La zona y el tamaño ayudan a pensar cómo se lee una pieza.</p>
          <img
            class="tattoo-before-card__monogram"
            src={tattooBrand.marks.jt.src}
            width={tattooBrand.marks.jt.width}
            height={tattooBrand.marks.jt.height}
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          />
        </article>
        <article class="tattoo-before-card">
          <span class="tattoo-before-card__mark" aria-hidden="true">
            03
          </span>
          <p class="tattoo-eyebrow">LA PIEZA</p>
          <h3>Una propuesta definida</h3>
          <p>La idea se conversa y se define antes de tatuar.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="tattoo-process" id="como-trabajamos" aria-labelledby="process-title">
    <div class="container">
      <div class="tattoo-section-heading">
        <p class="tattoo-eyebrow">UN CAMINO PARA CADA PROYECTO</p>
        <h2 id="process-title">Cómo trabajamos</h2>
      </div>
      <div class="tattoo-process__grid">
        <article class="tattoo-process-card">
          <span class="tattoo-process-card__number">01 / COORDINACIÓN</span>
          <h3>Piezas pequeñas</h3>
          <p>Escribile a Juanjo para conversar la idea y coordinar el próximo paso.</p>
          <ButtonLink href={tattooActions.turnsHref} variant="primary" size="compact">
            Sacar turno
          </ButtonLink>
        </article>
        <article class="tattoo-process-card tattoo-process-card--large">
          <span class="tattoo-process-card__number">02 / PROYECTO PERSONALIZADO</span>
          <h3>Proyectos grandes</h3>
          <p>Los proyectos de mayor escala requieren una conversación y un presupuesto previo.</p>
          <TattooInstagramLink showHandle={false} className="tattoo-inline-instagram">
            Consultar por Instagram
          </TattooInstagramLink>
        </article>
      </div>
    </div>
  </section>

  <section class="tattoo-guide-teaser" aria-labelledby="guide-teaser-title">
    <div class="container tattoo-guide-teaser__inner">
      <div class="tattoo-guide-teaser__intro">
        <p class="tattoo-eyebrow">UNA GUÍA PARA TU SESIÓN</p>
        <h2 id="guide-teaser-title">Antes y después de tatuarte</h2>
        <p>Preparación, escala y cuidados en una guía breve para acompañar el proceso.</p>
        <ButtonLink href="/guia/" variant="secondary">
          Ver guía
        </ButtonLink>
      </div>
      <div class="tattoo-guide-teaser__cards">
        <a href="/guia/#preparacion">
          <span>01</span>
          <strong>Antes de venir</strong>
          <b aria-hidden="true">↗</b>
        </a>
        <a href="/guia/#sensibilidad">
          <span>02</span>
          <strong>Sensibilidad por zona</strong>
          <b aria-hidden="true">↗</b>
        </a>
        <a href="/guia/#cuidados">
          <span>03</span>
          <strong>Cuidados</strong>
          <b aria-hidden="true">↗</b>
        </a>
      </div>
    </div>
  </section>

  <section class="tattoo-home-cta" aria-labelledby="home-cta-title">
    <div class="container tattoo-home-cta__inner">
      <div>
        <p class="tattoo-eyebrow">EL PRÓXIMO PASO</p>
        <h2 id="home-cta-title">¿Tenés una idea?</h2>
      </div>
      <div class="tattoo-home-cta__actions">
        <ButtonLink href={tattooActions.turnsHref} variant="primary">
          Sacar turno
        </ButtonLink>
        <TattooInstagramLink showHandle={false} className="tattoo-inline-instagram">
          Consultar por Instagram
        </TattooInstagramLink>
      </div>
    </div>
  </section>
</TattooSiteLayout>
