---
import TattooLegalPage from '../components/TattooLegalPage.astro';
import TattooSiteLayout from '../layouts/TattooSiteLayout.astro';
---

<TattooSiteLayout
  title="Arrepentimiento | Juanjo Tattoo Studio"
  description="Información sobre consultas relacionadas con el estudio y sus servicios."
>
  <TattooLegalPage
    title="Arrepentimiento"
    description="Canales de contacto para iniciar una consulta con el estudio."
  >
    <section>
      <h2>Cómo iniciar una consulta</h2>
      <p>
        El sitio no cuenta con correo ni formulario propio para solicitudes. Podés comunicarte con
        el estudio desde la sección Contacto para conocer el canal adecuado según tu caso.
      </p>
    </section>
    <section>
      <h2>Solicitudes de consumidores</h2>
      <p>
        Los derechos aplicables se rigen por la normativa vigente. Esta página no limita los
        derechos que pudieran corresponder.
      </p>
    </section>
  </TattooLegalPage>
</TattooSiteLayout>
