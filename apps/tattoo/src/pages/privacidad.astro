---
import TattooLegalPage from '../components/TattooLegalPage.astro';
import TattooSiteLayout from '../layouts/TattooSiteLayout.astro';
import Link from '@littzite/ui/Link.astro';
import { tattooLegal, tattooLegalEmailHref } from '../release-readiness.ts';
---

<TattooSiteLayout
  title="Política de privacidad | Juanjo Tattoo Studio"
  description="Información sobre los datos técnicos del sitio y los servicios externos vinculados."
>
  <TattooLegalPage
    title="Política de privacidad"
    description="Qué datos técnicos pueden tratarse y qué ocurre al abrir servicios externos."
  >
    <section>
      <h2>Datos tratados por este sitio</h2>
      <p>
        Este sitio estático no incorpora cuentas, formularios propios, base de datos ni herramientas
        propias de analítica o publicidad. La infraestructura que entrega y protege el sitio puede
        tratar datos técnicos de conexión conforme a sus condiciones vigentes.
      </p>
    </section>
    <section>
      <h2>Cal.com e Instagram</h2>
      <p>
        Los botones de turnos y consultas pueden abrir Cal.com o Instagram. Al salir del sitio, esos
        servicios aplican sus propias políticas. Revisá sus avisos antes de compartir información
        personal.
      </p>
    </section>
    <section>
      <h2>Google Maps</h2>
      <p>
        La página de Contacto incorpora un mapa de Google Maps y un enlace de indicaciones. Al
        cargar el mapa o abrir el enlace, Google puede recibir datos técnicos de conexión conforme a
        sus políticas y a la configuración del servicio.
      </p>
    </section>
    <section>
      <h2>Responsable y consultas</h2>
      <p>
        El prestador responsable informado para este sitio es {tattooLegal.providerName}. Para
        consultas sobre privacidad, escribí a{' '}
        {tattooLegalEmailHref ? (
          <Link href={tattooLegalEmailHref}>{tattooLegal.contactEmail}</Link>
        ) : (
          tattooLegal.contactEmail
        )}
        . Este sitio no tiene formularios ni base de datos propios; los datos que compartas con
        Cal.com, Instagram o Google Maps quedan sujetos a las políticas de cada servicio.
      </p>
    </section>
  </TattooLegalPage>
</TattooSiteLayout>
