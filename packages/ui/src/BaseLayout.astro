---
import type { SiteConfig } from '@littzite/content-schema';

interface Props {
  locale: SiteConfig['defaultLocale'];
  title: string;
  noindex: boolean;
}

const { locale, title, noindex } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>
