---
import type { SeoMetadata, SiteConfig } from '@littzite/content-schema';
import './styles.css';

interface Props {
  locale: SiteConfig['defaultLocale'];
  theme: SiteConfig['theme'];
  seo: SeoMetadata;
  noindex: boolean;
  iconHref?: SiteConfig['iconHref'];
  bodyClass?: string;
}

const { locale, theme, seo, noindex, iconHref, bodyClass } = Astro.props;
const themeStyle = {
  '--color-surface': theme.surface,
  '--color-text': theme.text,
  '--color-accent': theme.accent,
  '--color-accent-text': theme.accentText,
  '--color-border': theme.border,
  '--color-focus': theme.focus,
};
---

<!doctype html>
<html lang={locale} style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {iconHref && <link rel="icon" href={iconHref} />}
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
  </head>
  <body id="inicio" class={bodyClass}>
    <a class="skip-link" href="#contenido">
      Ir al contenido
    </a>
    <slot name="header" />
    <main id="contenido">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
