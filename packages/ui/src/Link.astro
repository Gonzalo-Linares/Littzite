---
interface Props {
  href: string;
}

const { href } = Astro.props;
const safeInternal = href.startsWith('#') && href.length > 1 || href.startsWith('/') && !href.startsWith('//');
const safeExternal = href.startsWith('https://') && !new URL(href).username && !new URL(href).password;
if (!safeInternal && !safeExternal) throw new Error('Unsupported link URL');
---

<a class="action-link" href={href}><slot /></a>
