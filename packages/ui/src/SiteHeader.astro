---
import { isAllowedHref } from './link-utils';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  brand: string;
  descriptor: string;
  links: NavItem[];
}

const { brand, descriptor, links } = Astro.props;
if (!links.every((link) => isAllowedHref(link.href))) throw new Error('Invalid navigation link');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-mark" aria-label={brand}>
      <span class="site-mark__symbol" aria-hidden="true">✳</span>
      <span class="site-mark__name">{brand}</span>
      <span class="site-mark__descriptor">{descriptor}</span>
    </a>
    <nav class="site-nav" aria-label="Navegación principal">
      {links.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="site-header__badge" href="#alcance">Vista previa <span aria-hidden="true">↗</span></a>
  </div>
</header>
