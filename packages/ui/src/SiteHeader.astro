---
import { isAllowedHref } from './link-utils';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  brand: string;
  descriptor: string;
  links: NavItem[];
  badge?: NavItem;
}

const { brand, descriptor, links, badge } = Astro.props;
if (![...links, ...(badge ? [badge] : [])].every((link) => isAllowedHref(link.href))) throw new Error('Invalid navigation link');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-mark" aria-label={brand}>
      <slot name="brand">
        <span class="site-mark__symbol" aria-hidden="true">✳</span>
        <span class="site-mark__name">{brand}</span>
        <span class="site-mark__descriptor">{descriptor}</span>
      </slot>
    </a>
    <nav class="site-nav" aria-label="Navegación principal">
      {links.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    {badge && <a class="site-header__badge" href={badge.href}>{badge.label} <span aria-hidden="true">↗</span></a>}
  </div>
</header>
