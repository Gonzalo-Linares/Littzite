---
import ButtonLink from './ButtonLink.astro';

interface Props {
  brand: string;
  note: string;
  meta?: [string, string];
}

const { brand, note, meta } = Astro.props;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <slot name="brand">
        <p class="site-footer__brand">{brand}</p>
      </slot>
      <p class="site-footer__note">{note}</p>
    </div>
    <slot name="links" />
    <slot name="attribution" />
    <ButtonLink href="#inicio" variant="quiet" size="compact">
      Volver arriba
    </ButtonLink>
  </div>
  {Astro.slots.has('secondary-links') && (
    <div class="container site-footer__secondary">
      <slot name="secondary-links" />
    </div>
  )}
  {meta && (
    <div class="container site-footer__meta">
      <span>{meta[0]}</span>
      <span>{meta[1]}</span>
    </div>
  )}
</footer>
